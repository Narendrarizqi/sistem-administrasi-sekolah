            margin-top: 16px;
            display: flex;
            align-items: flex-start;
            gap: 8px;
            line-height: 1.5;
        }

        .db-chart-container {
            position: relative;
            width: 170px;
            height: 170px;
            margin: 0 auto;
        }

        .db-chart-center-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            pointer-events: none;
        }

        .db-chart-percent {
            font-size: 19px;
            font-weight: 700;
            color: var(--color-text);
            line-height: 1.1;
        }

        .db-chart-sub {
            font-size: 11px;
            color: var(--color-text-secondary);
        }

        .db-legend-item {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
            font-size: 13.5px;
        }

        .db-legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .db-table-badge {
            padding: 4px 10px;
            font-size: 11.5px;
            font-weight: 600;
            border-radius: 20px;
        }

        /* Smooth transition for breakdown collapsible */
        #collapseRincianJenis {
            max-height: 0;
            overflow: hidden;
            opacity: 0;
            transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease, margin 0.3s ease;
            margin-top: 0;
        }

        #collapseRincianJenis.is-open {
            max-height: 400px;
            opacity: 1;
            margin-top: 8px;
        }

        #iconChevronRincian {
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        #iconChevronRincian.rotate {
            transform: rotate(180deg);
        }

        /* ── Table Responsive & Horizontal Scroll ── */
        .table-responsive {
            display: block !important;
            width: 100% !important;
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch !important;
            margin-bottom: 0 !important;
        }

        .table-responsive::-webkit-scrollbar {
            height: 7px;
            width: 7px;
        }

        .table-responsive::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }

        .table-responsive::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

        .table-responsive::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        .table-responsive > table,
        .table-responsive > .table {
            width: 100% !important;
            min-width: 900px !important;
            margin-bottom: 0 !important;
        }

        .modal .table-responsive > table,
        .modal .table-responsive > .table {
            min-width: 650px !important;
        }

        .table-responsive .table th,
        .table-responsive .table td {
            white-space: nowrap !important;
            vertical-align: middle !important;
        }

        /* Uniform table action buttons */
        .table td .btn.btn-sm,
        .table td .btn-add,
        .table td .action-btn,
        .table td .btn-cetak-pdf,
        .table td a.btn-sm,
        .table td button.btn-sm {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            width: 33px !important;
            height: 33px !important;
            min-width: 33px !important;
            min-height: 33px !important;
            max-width: 33px !important;
            max-height: 33px !important;
            padding: 0 !important;
            font-size: 13px !important;
            line-height: 1 !important;
            border-radius: 8px !important;
            box-sizing: border-box !important;
            vertical-align: middle !important;
            transition: all 0.15s ease !important;
        }

        .table td .btn.btn-sm i,
        .table td .btn-add i,
        .table td .action-btn i,
        .table td .btn-cetak-pdf i {

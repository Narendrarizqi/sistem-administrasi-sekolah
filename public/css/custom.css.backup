}

.btn-secondary {
    background-color: #ffffff;
    color: #6b7280;
    border-color: #6b7280;
    border-width: 1px;
    border-style: solid;
    border-radius: 12px;
    padding: 0.55rem 1rem;
    font-weight: 600;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
    transition: transform .18s ease, background-color .18s ease, border-color .18s ease, color .18s ease;
}

.btn-secondary:hover,
.btn-secondary:focus {
    background-color: #6b7280;
    border-color: #6b7280;
    color: #ffffff;
    transform: translateY(-1px);
}

.btn-secondary:active {
    background-color: #4b5563;
    border-color: #4b5563;
}

.btn-secondary i {
    margin-right: 0.5rem;
}

#modalNaikKelas .modal-content {
    border: none !important;
    border-radius: 10px;
    overflow: hidden;
}

#modalNaikKelas .modal-header {
    background-color: #198754 !important;
    border-bottom: none !important;
    color: #ffffff !important;
}

#modalNaikKelas .modal-title {
    color: #ffffff !important;
}

#modalNaikKelas .modal-header .text-warning {
    color: #ffffff !important;
}

#modalNaikKelas .modal-body {
    background-color: #ffffff !important;
}

#modalNaikKelas .alert-warning {
    background-color: #d1e7dd !important;
    border-color: #badbcc !important;
    color: #146c43 !important;
}

#modalNaikKelas .alert-success {
    background-color: #d1e7dd !important;
    border-color: #badbcc !important;
    color: #146c43 !important;
}

#modalNaikKelas .modal-footer {
    background-color: #ffffff !important;
}

.ms-auto d-flex align-items-center {
    background: rgba(239, 68, 68, 0.14);
    color: #b91c1c;
    border-color: rgba(239, 68, 68, 0.35);
}

.ms-auto d-flex align-items-center:hover,
.ms-auto d-flex align-items-center:focus {
    background: #ef4444;
    color: #ffffff;
    border-color: #ef4444;
}

/* ==========================================================================
   GLOBAL TABLE RESPONSIVE & HORIZONTAL SCROLL STYLING
   ========================================================================== */

.table-responsive {
    display: block !important;
    width: 100% !important;
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch !important;
    margin-bottom: 0 !important;
}

/* Modern smooth scrollbar for table-responsive */
.table-responsive::-webkit-scrollbar {
    height: 7px;
    width: 7px;
}

.table-responsive::-webkit-scrollbar-track {
    background: #f1f5f9;
    border-radius: 4px;
}

.table-responsive::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
}

.table-responsive::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
}

/* Ensure all tables inside table-responsive stay wider with horizontal scroll */
.table-responsive > table,
.table-responsive > .table {
    width: 100% !important;
    min-width: 900px !important;
    margin-bottom: 0 !important;
}

/* Extra wide tables (e.g. Rekap, Target Tahunan, etc.) */
.target-table-wrap > table,
.rekap-table-wrap > table,
#rekapTable,
#targetTable,
.target-table {
    min-width: 1100px !important;
}

/* Specific modal tables */
.modal .table-responsive > table,
.modal .table-responsive > .table {
    min-width: 650px !important;
}

/* Table cells styling for consistent spacing and no unwanted text wraps */
.table-responsive .table th,
.table-responsive .table td {
    white-space: nowrap !important;
    vertical-align: middle !important;
}

.table-responsive .table th.allow-wrap,
.table-responsive .table td.allow-wrap,
.table-responsive .table td .wrap-text {
    white-space: normal !important;
    min-width: 180px !important;
}

/* ==========================================================================
   UNIFORM TABLE ACTION BUTTONS (AKSI)
   ========================================================================== */

/* All action buttons inside table cells have identical 33x33px square dimensions */
.table td .btn.btn-sm,
.table td .btn-add,
.table td .action-btn,
.table td .btn-cetak-pdf,
.table td a.btn-sm,
.table td button.btn-sm {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 33px !important;
    height: 33px !important;
    min-width: 33px !important;
    min-height: 33px !important;
    max-width: 33px !important;
    max-height: 33px !important;
    padding: 0 !important;
    font-size: 13px !important;
    line-height: 1 !important;
    border-radius: 8px !important;
    box-sizing: border-box !important;
    vertical-align: middle !important;
    transition: all 0.15s ease !important;
}

/* Allow buttons with text inside tables (like "Aktifkan" in tahun ajaran) to auto-size */
.table td .btn.btn-sm:has(span),
.table td .btn.btn-sm.btn-with-text,
.table td .btn-outline-success:has(i.me-1),
.table td .btn-success.disabled {
    width: auto !important;
    min-width: auto !important;
    max-width: none !important;
    padding: 0.35rem 0.75rem !important;
    font-size: 12.5px !important;
}

/* Ensure icons inside action buttons are crisp & centered */
.table td .btn.btn-sm i,
.table td .btn-add i,
.table td .action-btn i,
.table td .btn-cetak-pdf i {
    font-size: 13px !important;
    line-height: 1 !important;
    margin: 0 !important;
}

/* Hover effects */
.table td .btn.btn-sm:hover,
.table td .btn-add:hover,
.table td .action-btn:hover,
.table td .btn-cetak-pdf:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12) !important;
}

/* ============================================
   GLOBAL STAT CARD STYLES (MODERN PASTEL TINT)
   ============================================ */

.stat-card {
    position: relative !important;
    border-radius: 18px !important;
    padding: 18px 20px 16px 20px !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02), 0 1px 3px rgba(0, 0, 0, 0.02) !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    height: 100% !important;
    min-height: 0 !important;
    transition: transform 0.22s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.22s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.22s ease !important;
    overflow: hidden !important;
    border: 1px solid transparent !important;
}

.stat-card::before {
    display: none !important;
    content: none !important;
}

.stat-card:hover {
    transform: translateY(-3px) !important;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06), 0 2px 6px rgba(0, 0, 0, 0.03) !important;
}

.stat-card .stat-top {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 14px !important;
    width: 100% !important;
    min-width: 0 !important;
}

.stat-card .stat-icon {
    flex-shrink: 0 !important;
    width: 48px !important;
    height: 48px !important;
    border-radius: 50% !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 19px !important;
    color: #ffffff !important;
    margin: 0 !important;
    transition: transform 0.2s ease !important;
}

.stat-card:hover .stat-icon {
    transform: scale(1.06) !important;
}

.stat-card .stat-content {
    flex: 1 !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding-left: 0 !important;
    border-left: none !important;
    text-align: left !important;
}

.stat-card .stat-label {
    display: block !important;
    font-size: 12.5px !important;
    font-weight: 700 !important;
    margin-bottom: 2px !important;
    line-height: 1.3 !important;
    letter-spacing: 0.2px !important;
}

.stat-card .stat-value {
    margin: 0 !important;
    font-size: clamp(1.05rem, 1.6vw, 1.35rem) !important;
    font-weight: 800 !important;
    line-height: 1.25 !important;
    overflow-wrap: anywhere !important;
    word-break: break-word !important;
}

.stat-card .stat-desc {
    display: block !important;
    margin-top: 3px !important;
    font-size: 11.5px !important;
    font-weight: 500 !important;
    opacity: 0.9 !important;
    overflow-wrap: anywhere !important;
}

.stat-card .stat-footer {
    margin-top: auto !important;
    padding-top: 10px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    text-decoration: none !important;
    transition: transform 0.15s ease, opacity 0.15s ease !important;
}

.stat-card .stat-footer:hover {
    opacity: 0.85 !important;
    transform: translateX(2px) !important;
}

/* Color Themes */
